# Template processado pelo entrypoint da imagem oficial do nginx:
# ${API_UPSTREAM} e ${NGINX_LOCAL_RESOLVERS} vêm de variáveis de ambiente.
server {
    listen 8080;
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;

    # Resolve o nome da API a cada requisição (e não só na inicialização),
    # para o nginx subir mesmo se a API ainda não existir.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=30s ipv6=off;
    set $api http://${API_UPSTREAM};

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Rotas da API: o navegador fala só com este servidor, sem CORS
    location ~ ^/(v1/|docs$|openapi\.json$|readyz$) {
        proxy_pass $api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff";
        add_header Referrer-Policy "strict-origin-when-cross-origin";
        add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; frame-ancestors 'none'";
    }
}
